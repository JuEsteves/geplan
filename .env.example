# GEPLAN — variáveis de ambiente (EXEMPLO; não coloque valores reais neste arquivo).
#
# O site é estático (sem build): o navegador lê a URL e a chave pública direto de js/config.js.
# Estas variáveis servem para as ferramentas de linha de comando (Supabase CLI, backups) e para as
# funções de servidor da Fase 8 (pagamentos). Copie para ".env" (que NÃO vai para o GitHub) e preencha.

# --- Públicas (também em js/config.js) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# --- SECRETAS: somente no servidor (Supabase Edge Functions / Vercel Functions). Nunca no navegador. ---
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta ao Postgres (backups com pg_dump e migrações pela CLI)
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# --- Fase 8 (pagamentos) — ainda não utilizadas ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
